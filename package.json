{
  "name": "atlas-c6",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "seed": "node -e \"import('./server/db.mjs').then(m=>{m.initSchema({seed:true});console.log('Base de datos regenerada con datos reales.')})\"",
    "test": "node server/test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test",
    "auditar": "node tools/auditoria.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "ATLAS_C6 — Dashboard de analítica de datos territoriales. Comuna 6, Medellín."
}
